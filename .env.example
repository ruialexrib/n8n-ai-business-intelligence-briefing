# Pin these versions before using the project in production.
N8N_VERSION=latest
OLLAMA_VERSION=latest

N8N_PORT=5678
OLLAMA_PORT=11434
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Europe/Lisbon
TZ=Europe/Lisbon

# Generate a long random value. Never commit the resulting .env file.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Must match the model configured in the workflow.
OLLAMA_MODEL=llama3.2:3b
